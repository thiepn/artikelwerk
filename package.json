{
  "name": "artikelwerk",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "German noun-gender trainer with 1,000-word Challenge C1/C2 and 1,000-word Bridge B2/C1 tracks",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/verify-source.mjs",
    "build": "node scripts/build.mjs",
    "test:build": "node scripts/verify-dist.mjs",
    "test:browser": "node tests/practice-screen.mjs",
    "ci:static": "npm run check && npm run certify:content && npm run certify:bridge && npm run build && npm run test:build",
    "certify:content": "node scripts/certify-content.mjs",
    "test:content-browser": "node tests/content-runtime.mjs",
    "test:shell-browser": "node tests/app-shell.mjs",
    "test:surfaces-browser": "node tests/surface-polish.mjs",
    "test:a11y-browser": "node tests/accessibility-finish.mjs",
    "test:editorial-browser": "node tests/editorial-ui.mjs",
    "test:visual-acceptance-browser": "node tests/visual-acceptance.mjs",
    "test:tracks-browser": "node tests/vocabulary-tracks.mjs",
    "certify:bridge": "node scripts/certify-bridge.mjs",
    "test:bridge-browser": "node tests/bridge-corpus.mjs"
  },
  "devDependencies": {
    "playwright": "1.55.0"
  }
}
