let verifySource = verifySourceRaw;
verifySource = replaceOnce(
  verifySource,
  "requireFragment(html, '<script src=\"translations.js\"></script>', 'local translation asset');\n",
  "requireFragment(html, '<script src=\"translations.js\"></script>', 'local translation asset');\nrequireFragment(html, 'provenance:Object.freeze(window.ARTIKELWERK_TRANSLATION_PROVENANCE||{})', 'runtime translation certification gate');\nrequireFragment(html, 'contentCertification:window.ARTIKELWERK_TRANSLATION_PROVENANCE?.[id]||null', 'per-word content certification metadata');\n",
  'source certification fragments',
);
await writeFile(paths.verifySource, verifySource, 'utf8');

let ci = ciRaw;
