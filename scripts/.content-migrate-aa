import { mkdir, readFile, writeFile } from 'node:fs/promises';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import vm from 'node:vm';

const scriptsDir = dirname(fileURLToPath(import.meta.url));
const rootDir = dirname(scriptsDir);
const REVIEW_DATE = '2026-08-28';
const CERTIFICATION_ID = 'CC2-2026-08-28';

const paths = {
  html: join(rootDir, 'index.html'),
  translations: join(rootDir, 'translations.js'),
  coverage: join(rootDir, 'docs', 'translation-coverage.txt'),
  generator: join(rootDir, 'scripts', 'generate_translations.py'),
  package: join(rootDir, 'package.json'),
  build: join(rootDir, 'scripts', 'build.mjs'),
  verifySource: join(rootDir, 'scripts', 'verify-source.mjs'),
  ci: join(rootDir, '.github', 'workflows', 'ci.yml'),
  readme: join(rootDir, 'README.md'),
};

const [htmlRaw, translationsRaw, coverage, generator, packageRaw, buildRaw, verifySourceRaw, ciRaw, readmeRaw] = await Promise.all([
  readFile(paths.html, 'utf8'),
  readFile(paths.translations, 'utf8'),
  readFile(paths.coverage, 'utf8'),
  readFile(paths.generator, 'utf8'),
  readFile(paths.package, 'utf8'),
  readFile(paths.build, 'utf8'),
  readFile(paths.verifySource, 'utf8'),
  readFile(paths.ci, 'utf8'),
  readFile(paths.readme, 'utf8'),
]);

function fail(message) { throw new Error(message); }
function replaceOnce(source, oldValue, newValue, label) {
  const count = source.split(oldValue).length - 1;
  if (count !== 1) fail(`${label}: expected one match, found ${count}`);
  return source.replace(oldValue, newValue);
}
function parseVocabulary(html) {
  const validArticles = new Set(['der', 'die', 'das']);
  const rows = [];
  for (const line of html.split(/\r?\n/)) {
    const value = line.trim();
    if (!value.startsWith('["') || !value.endsWith('],')) continue;
    try {
      const row = JSON.parse(value.slice(0, -1));
      if (Array.isArray(row) && row.length >= 7 && validArticles.has(row[2]) && Number.isInteger(row[3])) rows.push(row);
    } catch { /* not a vocabulary row */ }
  }
  return rows;
}
function loadTranslationGlobals(source) {
  const context = { window: {} };
  vm.runInNewContext(source, context, { filename: 'translations.js' });
  return context.window;
}

const vocabulary = parseVocabulary(htmlRaw);
if (vocabulary.length !== 1000) fail(`Expected 1000 vocabulary rows before migration, found ${vocabulary.length}`);
const vocabularyById = new Map(vocabulary.map((row) => [row[0], row]));

const currentGlobals = loadTranslationGlobals(translationsRaw);
const translations = { ...(currentGlobals.ARTIKELWERK_TRANSLATIONS || {}) };
if (Object.keys(translations).length !== 1000) fail(`Expected 1000 translation entries before migration, found ${Object.keys(translations).length}`);

const fallbackBlock = coverage.split('fallback_entries:\n')[1]?.split('\n\nderived_entries:')[0] || '';
const currentFallbackIds = new Set(fallbackBlock.split(/\r?\n/).filter(Boolean).map((line) => line.split('\t')[0]));
const derivedBlock = coverage.split('derived_entries:\n')[1] || '';
const derivedIds = new Set(derivedBlock.split(/\r?\n/).filter(Boolean).map((line) => line.split('\t')[0]));
const curatedBody = generator.match(/CURATED_OVERRIDES\s*=\s*\{([\s\S]*?)\n\}/)?.[1] || '';
const curatedIds = new Set([...curatedBody.matchAll(/^\s*"([a-z0-9_-]+)"\s*:/gm)].map((match) => match[1]));

const editorialOverrides = {
  handlungsansatz: 'approach to action; course of action',
  kompetenzprofil: 'competency profile; skills profile',
  bewertungsansatz: 'evaluation approach',
  interpretationsansatz: 'interpretive approach',
  deutungsansatz: 'interpretive approach',
  analyseansatz: 'analytical approach',
  forschungsansatz: 'research approach',
  grundbedarf: 'basic need; basic requirement',
  handlungsdruck: 'pressure to act',
  methodenmix: 'mix of methods',
  mitteleinsatz: 'use of resources',
  normenkonflikt: 'conflict of norms',
  regelungsbedarf: 'need for regulation; regulatory need',
  themenspektrum: 'range of topics',
  anforderungsniveau: 'level of requirements',
  aussagekriterium: 'criterion for a statement; claim criterion',
  erkenntnispotenzial: 'potential for insight; knowledge potential',
  erkenntnisziel: 'objective of inquiry; knowledge objective',
  erkenntnisniveau: 'level of knowledge',
  erkenntnismodell: 'model of knowledge',
  zielmodell: 'target model',
  zielprinzip: 'target principle',
};
for (const [id, gloss] of Object.entries(editorialOverrides)) {
  if (!vocabularyById.has(id)) fail(`Editorial override refers to unknown vocabulary id: ${id}`);
  translations[id] = gloss;
}

